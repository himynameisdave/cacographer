{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		// `bun` alongside `node`: client unit tests under `src/**` import `bun:test`.
		"types": ["$app/types", "node", "bun"],
		// `$app/tsconfig` sets this too, but it only exists once `svelte-kit sync` has written
		// `node_modules/$app/tsconfig.json`. Setting it here as well means a checkout that has not
		// synced yet fails to *extend* rather than falling back to emitting `.js`/`.js.map` next to
		// every source file under `src/`.
		"noEmit": true
	},
	"include": ["src", "vite.config.ts", "test"]
}
